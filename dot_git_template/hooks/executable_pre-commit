#!/usr/bin/env sh

# This script checks url mismatch.
# I.e. if any remote urls contain the current git user's name.

GIT_ROOT="$(git rev-parse --show-toplevel)"
SPC_PATH="${GIT_ROOT}/.git/.skip-pre-commit"
DOT_GIT_USERS_PATH=~/.git_users
FILE_INFO_HEADER="# this file is generated by the pre-commit hook"

main() {
  # enable interactive mode
  exec < /dev/tty

  # skip if nomore_prompt is previously called
  if [[ -e "$SPC_PATH" ]]
  then
    exit 0
  fi

  GIT_USER="$(git config --get "user.name")"

  # skip if urls do contain GIT_USER
  SKIP_CHECK=true
  for REMOTE in "$(git remote)"
  do
    URL="$(git config --get "remote.${REMOTE}.url")"
    if [[ "$URL" != *${GIT_USER}* ]]
    then
      SKIP_CHECK=false
    fi
  done
  if "$SKIP_CHECK"
  then
    exit 0
  fi

  read -p "Some remote urls do not contain \"${GIT_USER}\", change git user? [y/n]: " CHANGE_USR
  case "$CHANGE_USR" in
    'y')
      change_usr
      nomore_prompt
      exit 0
      ;;
    'n')
      nomore_prompt
      exit 0
      ;;
    *)
      exit 1
      ;;
  esac

  exit 1
}

nomore_prompt() {
  echo "$FILE_INFO_HEADER" > "$SPC_PATH"
}

change_usr() {
  if [[ ! -e "$DOT_GIT_USERS_PATH" ]]
  then
    touch "$DOT_GIT_USERS_PATH"
    echo "$FILE_INFO_HEADER" > "$DOT_GIT_USERS_PATH"
    init_usr
    return 0
  fi

  choose_usr
}

choose_usr() {
  echo "Select user:"
  echo "0. Init new user"
  local USERS="$(tail "$DOT_GIT_USERS_PATH" -n +2)"
  local i=1
  for USER in "$USERS"
  do
    local USERNAME="$(echo "$USER") | awk -F, {print \$1}"
    local EMAIL="$(echo "$USER") | awk -F, {print \$2}"
    echo "${i}. $USER"
    i=$((i+1))
  done

  read -p "Enter number: " NO

  if [[ "$NO" == "0" ]]
  then
    init_usr
    return 0
  fi

  USERNAME="$(echo "$USERS" | awk -F, "NR==${NO}{print \$1}")"
  EMAIL="$(echo "$USERS" | awk -F, "NR==${NO}{print \$2}")"
  set_usr "$USERNAME" "$EMAIL"
}

init_usr() {
  prompt_usr
  set_usr "$USERNAME" "$EMAIL"
  save_usr "$USERNAME" "$EMAIL"
}

prompt_usr() {
  read -p 'Enter user.name: ' USERNAME
  read -p 'Enter user.email: ' EMAIL
}

# $1: user.name
# $2: user.email
set_usr() {
  git config --local user.name "$1"
  git config --local user.email "$2"
}

# $1: user.name
# $2: user.email
save_usr() {
  echo "$1,$2" >> "$DOT_GIT_USERS_PATH"
}

main
