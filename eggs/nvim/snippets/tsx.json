{
  "function": {
    "prefix": "f",
    "body": ["function ${1:name}(${2:parameters}) {", " ${3:body}", "}"]
  },
  "state": {
    "prefix": "s",
    "body": ["const [${1:state}, set${1:state}] = useState(${initialValue})"]
  },
  "createContext": {
    "prefix": "cc",
    "body": ["const ${name}Ctx = createContext(${initialValue})"]
  },
  "contextProvider": {
    "prefix": "cp",
    "body": [
      "function ${1:contextName}Provider({ initialValue, children }: { initialValue: ${2:type}, children: ReactNode }) {",
      " $0",
      " return <${3:context}.Provider value={initialValue}>{children}</${3:context}.Provider>",
      "}"
    ]
  }
}
