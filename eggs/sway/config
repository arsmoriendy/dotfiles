# Read `man 5 sway` for a complete reference.

# Variables {
  # Logo key. Use Mod1 for Alt.
  set $mod Mod4
  # Home row direction keys, like vim
  set $left h
  set $down j
  set $up k
  set $right l

  set $term "wezterm"
  set $browser "firefox"
  set $filemanager "thunar"
# Variables }

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

# Clipboard {
  exec wl-paste --type text --watch cliphist store
  exec wl-paste --type image --watch cliphist store
# Clipboard }

# Polkit
exec $polkitgnomeexec

# eww
exec "eww daemon"

# vicinae
exec "vicinae server"

# swaync
exec "swaync"

# batsignal
exec "batsignal -W 'Low battery' -C 'Critical battery' -b"

# Focus options {
  focus_wrapping workspace
  focus_follows_mouse no
# Focus options }

# xwayland indicator
for_window [shell="xwayland"] title_format "[XWayland] %title"

smart_borders on

output "*" {
  background "./assets/background.jpg" fill
}

# Includes {
  # sytem wide
  include /etc/sway/config.d/*

  # load colors first, precedence matters
  include ~/.config/sway/config.d/colors.swayconfig
  include ~/.config/sway/config.d/*.swayconfig

  # sytem specific
  include ~/.config/sway/system-specific/*.swayconfig
# Includes }

seat seat0 xcursor_theme Adwaita 24
